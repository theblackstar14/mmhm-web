---
import '../styles/global.css';
import '../styles/obras.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description?: string; image?: string; nav?: string; leaflet?: boolean; solidHeader?: boolean; sinCanonical?: boolean }
const { solidHeader = false, sinCanonical = false, title, description = 'MM High Metrik Engineers S.A.C. — servicios integrales de construcción, remodelación y mantenimiento en Lima y Puno.', image, nav, leaflet = false } = Astro.props;
// Solo se indexa si el build recibe PUBLIC_INDEXABLE=true; cualquier otro valor deja noindex.
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';
// Vercel define VERCEL=1 en su build; fuera de allí, el script de analítica daría 404.
const enVercel = process.env.VERCEL === '1';
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(image ?? '/assets/hero-excavadora.jpg', Astro.site).href;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'}>
<title>{title}</title>
<meta name="description" content={description}>
{!sinCanonical && <link rel="canonical" href={canonical}>}
<meta property="og:type" content="website">
<meta property="og:locale" content="es_PE">
<meta property="og:site_name" content="MM High Metrik Engineers">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
{!sinCanonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={og} />
<meta property="og:image:alt" content={title} />
<meta name="twitter:image" content={og} />
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/assets/logo-blanco.png">
<link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin>
<slot name="head" />
{enVercel && <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>}
{enVercel && <script is:inline defer src="/_vercel/insights/script.js"></script>}
</head>
<body>
<Header nav={nav} solid={solidHeader} />
<main id="main">
<slot />
</main>
<Footer />
{leaflet && <script is:inline>
/* Carga Leaflet solo al necesitar un mapa. Su CSS va antes del propio, que sobrescribe algunos estilos. */
window.cargarLeaflet=(function(){
  var cdn='https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min', p;
  return function(){
    return p||(p=Promise.all([
      new Promise(function(ok,no){ var l=document.createElement('link'); l.rel='stylesheet'; l.href=cdn+'.css'; l.onload=ok; l.onerror=no; document.head.insertBefore(l,document.head.querySelector('link[rel=stylesheet],style')); }),
      new Promise(function(ok,no){ var s=document.createElement('script'); s.src=cdn+'.js'; s.onload=ok; s.onerror=no; document.head.appendChild(s); })
    ]));
  };
})();
</script>}
<script is:inline>
(function(){
  var h=document.getElementById('header'), nav=document.getElementById('nav'), b=document.getElementById('menuBtn');
  var fixed=h.hasAttribute('data-solid'); function s(){ h.classList.toggle('solid', fixed || scrollY>40); }
  addEventListener('scroll', s, {passive:true}); s();
  b.addEventListener('click', function(){ var o=nav.classList.toggle('open'); b.setAttribute('aria-expanded', o); });
  nav.addEventListener('click', function(e){ if(e.target.closest('a')){ nav.classList.remove('open'); b.setAttribute('aria-expanded','false'); } });
})();
</script>
<slot name="scripts" />
</body>
</html>

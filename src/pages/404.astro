---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada | MM High Metrik Engineers" description="La página que busca no existe o cambió de dirección." sinCanonical>
  <div class="page-hero doc-hero">
    <div class="wrap">
      <p class="crumbs"><a href="/">Inicio</a> / Página no encontrada</p>
      <h1>Página no encontrada</h1>
      <p>La dirección que abrió no existe o cambió. Puede continuar desde una de estas secciones.</p>
    </div>
  </div>
  <section class="doc-page">
    <div class="wrap" style="display:flex;flex-wrap:wrap;gap:12px">
      <a class="btn btn-primary" href="/">Ir al inicio</a>
      <a class="btn btn-line" href="/servicios/">Servicios</a>
      <a class="btn btn-line" href="/proyectos/">Proyectos</a>
      <a class="btn btn-line" href="/contacto/">Contacto</a>
    </div>
  </section>
</Base>

---
import Icon from './Icon.astro';
import { IC } from '../lib/icons';
import { SERVICIOS, FAMILIAS, WA, TEL, TEL_TXT, MAIL, BROCHURE, DIRECCION, DISTRITO, HORARIO, FACEBOOK, INSTAGRAM } from '../lib/site';
---
<footer>
  <div class="wrap">
    <div class="foot">
      <div class="foot-marca">
        <img src="/assets/logo-blanco.png" alt="MM High Metrik Engineers" loading="lazy">
        <p>Servicios integrales de construcción, remodelación y mantenimiento en Lima, Perú.</p>
        <div class="social">
          <a href={FACEBOOK} target="_blank" rel="noopener" aria-label="Facebook"><Icon d={IC.fb} fill /></a>
          <a href={INSTAGRAM} target="_blank" rel="noopener" aria-label="Instagram"><Icon d={IC.ig} /></a>
          <a href={`https://wa.me/${WA}`} target="_blank" rel="noopener" aria-label="WhatsApp"><Icon d={IC.wa} fill /></a>
        </div>
      </div>
      <div><h2>Empresa</h2><ul><li><a href="/nosotros/">Nosotros</a></li><li><a href="/servicios/">Servicios</a></li><li><a href="/proyectos/">Proyectos</a></li><li><a href="/contacto/">Contacto</a></li><li><a href={BROCHURE} target="_blank" rel="noopener">Brochure</a></li></ul></div>
      <div><h2>Especialidades</h2><ul>{Object.entries(FAMILIAS).map(([f, n]) => <li><a href={`/servicios/#esp-${f}`}>{n}</a></li>)}<li><a class="foot-mas" href="/servicios/">Ver los {SERVICIOS.length} servicios</a></li></ul></div>
      <div class="foot-contacto"><h2>Contacto</h2><ul><li><a href={`tel:${TEL}`}>{TEL_TXT}</a></li><li><a href={`mailto:${MAIL}`}>{MAIL}</a></li><li>{DIRECCION}, {DISTRITO}</li><li>{HORARIO}</li></ul></div>
    </div>
    <div class="legal"><span>© {new Date().getFullYear()} MM High Metrik Engineers S.A.C. Todos los derechos reservados.</span><span><a href="/privacidad/">Privacidad</a> &nbsp;·&nbsp; <a href="/terminos/">Términos</a></span></div>
  </div>
  <div class="giant" aria-hidden="true">HIGH METRIK</div>
</footer>

<aside aria-label="Contacto por WhatsApp"><a class="wa-float" href={`https://wa.me/${WA}?text=${encodeURIComponent('Hola, quisiera cotizar un proyecto.')}`} target="_blank" rel="noopener" aria-label="Escribir por WhatsApp"><Icon d={IC.wa} fill /></a></aside>
<nav class="mbar" aria-label="Contacto rápido">
  <a href={`tel:${TEL}`}><Icon d={IC.tel} />Llamar</a>
  <a class="m-wa" href={`https://wa.me/${WA}?text=${encodeURIComponent('Hola, quisiera cotizar un proyecto.')}`} target="_blank" rel="noopener"><Icon d={IC.wa} fill />WhatsApp</a>
  <a class="m-cot" href="/contacto/"><Icon d={IC.doc} />Cotizar</a>
</nav>
